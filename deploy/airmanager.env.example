# /etc/airmanager/airmanager.env (chmod 0600, owned by airmanager:airmanager)

AIRMANAGER_DATABASE_URL=postgresql+psycopg2://airmanager:CHANGE_ME_DB_PASS@127.0.0.1:5432/airmanager
AIRMANAGER_MASTER_KEY=CHANGE_ME_32_BYTE_FERNET_SECRET_KEY_2026
AIRMANAGER_AGENT_TOKEN=CHANGE_ME_AGENT_SHARED_SECRET_TOKEN
AIRMANAGER_ADMIN_USER=admin
AIRMANAGER_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
AIRMANAGER_AUTO_SEED=false

# Agent configuration
AIRMANAGER_BACKEND_URL=http://127.0.0.1:8001
AIRMANAGER_CORS_ORIGINS=http://localhost:3002,http://127.0.0.1:3002,https://airmanager.ahmedadil.me
PORT=8001
AIRMANAGER_SCAN_CONCURRENCY=64
AIRMANAGER_TCP_TIMEOUT_SEC=1.5
AIRMANAGER_POLL_INTERVAL_SEC=20
AIRMANAGER_SIMULATOR_MODE=false
